# Serverová vrstva je nepovinná. Bez těchhle proměnných aplikace běží dál,
# jen se nedá přihlásit a nefunguje žebříček — všechno ostatní je v telefonu.
#
# Obě hodnoty jsou veřejné záměrně: statický export nemá server, kam by se
# daly schovat, a samy o sobě nic neotevírají. Přístup hlídá Row Level
# Security v databázi, viz supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
